PORT=3000
HOST=127.0.0.1
# Optional: live AI suggestions. Without these, the app uses a labeled rule-based mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Persistent local data directory; defaults to ./data
DATA_DIR=./data
# Optional shared workspace gate. Set a long random secret; enter it in Settings.
# APP_ACCESS_TOKEN=

# RCA Copilot: loaded by the Python service. Never use a VITE_ prefix.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
COPILOT_URL=http://127.0.0.1:8001
